{
  "name": "rmango-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --experimental-strip-types --test tests/auth-urls.test.mjs",
    "build:cloudflare": "wrangler types --env-interface CloudflareEnv && opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cloudflare": "node scripts/sync-runtime-secrets.mjs && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "ai": "7.0.178",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.8",
    "jszip": "^3.10.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "agents": "0.34.0",
    "@ai-sdk/provider": "^4.0.0",
    "@opennextjs/cloudflare": "1.20.18"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=22"
  }
}
