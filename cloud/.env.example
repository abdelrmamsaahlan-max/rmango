# Server-only environment variables. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only API key. Never ship to the desktop app or source control.
SUPABASE_SECRET_KEY=
# Backward-compatible fallback for existing projects.
SUPABASE_SERVICE_ROLE_KEY=

# Synap OpenAI-compatible inference provider. Keep this secret on the cloud server.
# Create a free key at https://synap402.com/ and set it in Vercel Environment Variables.
SYNAP_API_KEY=

# Maximum generated answer length. Synap's free Qwen3 Coder profile allows up to 4096.
RMANGO_MAX_OUTPUT_TOKENS=4096
