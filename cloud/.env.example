# Local development only. Never commit real secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Backward-compatible server-only key for existing deployments.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI is provided by the "AI" binding in wrangler.jsonc.
# No AI provider key, gateway key, prepaid credits or payment method is required
# for the Cloudflare Workers Free plan's daily free allocation.

# Maximum generated answer length (bounded by the RMango database policy).
RMANGO_MAX_OUTPUT_TOKENS=4096
