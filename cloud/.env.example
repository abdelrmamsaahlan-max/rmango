# Cloudflare Worker Production runtime secrets.
# Add these under Workers & Pages > rmango > Settings > Variables and Secrets.
# Never prefix server-only values with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional Workers AI model overrides (defaults are in lib/ai/models.ts).
RMANGO_MODEL_FAST=
RMANGO_MODEL_DEVELOPER=
RMANGO_MODEL_THINK=
RMANGO_MODEL_VISION=
RMANGO_MODEL_AGENT=

# Optional comma-separated compatible fallback models.
RMANGO_MODEL_FALLBACKS_FAST=
RMANGO_MODEL_FALLBACKS_DEVELOPER=
RMANGO_MODEL_FALLBACKS_THINK=
RMANGO_MODEL_FALLBACKS_VISION=
RMANGO_MODEL_FALLBACKS_AGENT=

# Upper cap; Supabase usage_policies is the final quota and spend authority.
RMANGO_MAX_OUTPUT_TOKENS=4096
