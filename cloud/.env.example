# Server-only environment variables. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Canonical Cloudflare origin used for account recovery redirects (never derived from request headers).
RMANGO_PUBLIC_URL=https://rmango.abdosony222.workers.dev

# Recommended server-only Supabase API key (sb_secret_...). Never ship to desktop.
SUPABASE_SECRET_KEY=
# Backward-compatible fallback for projects still using the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI is configured through the Worker AI binding; no provider API key is needed.

# Optional admin-controlled model overrides. Each value must be a supported Workers AI model ID.
RMANGO_MODEL_FAST=
RMANGO_MODEL_DEVELOPER=
RMANGO_MODEL_THINK=
RMANGO_MODEL_VISION=
RMANGO_MODEL_AGENT=

# Comma-separated model IDs used as a provider/model fallback chain.
RMANGO_MODEL_FALLBACKS_FAST=
RMANGO_MODEL_FALLBACKS_DEVELOPER=
RMANGO_MODEL_FALLBACKS_THINK=
RMANGO_MODEL_FALLBACKS_VISION=
RMANGO_MODEL_FALLBACKS_AGENT=

# Cost / token limits (USD values and token counts); database policies remain authoritative.
RMANGO_MAX_OUTPUT_TOKENS=4096
